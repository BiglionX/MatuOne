# 服务端 Postgres（Neon）。不要加 VITE_ 前缀，不要把真实连接串写进这个文件。
DATABASE_URL=

# pg 连接池专用。必须是 Neon 的 pooler 地址（主机名带 -pooler），且不要带 channel_binding 参数。
# 线上服务器和 Vercel 预览都要配这一条；没配时会回退 DATABASE_URL 并打警告。
DATABASE_URL_POOLER=

# 素材文件上传到 Supabase Storage。服务端使用，不要加 VITE_ 前缀，不要把真实密钥写进这个文件。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
